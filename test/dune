; The command, where it needs no database.

(cram
 (applies_to command)
 (package rowtype-migrate)
 (enabled_if
  (and
   %{lib-available:rowtype-migrate.postgres}
   %{lib-available:rowtype-migrate.sqlite}))
 (deps %{bin:rowtype-migrate}))
