; The Postgres backend: statements, scalars, failures, the pool, verify and
; COPY.

(tests
 (names test_rowtype test_types test_errors test_pool test_verify test_copy)
 (package rowtype-postgres)
 (modules
  test_rowtype
  test_types
  test_errors
  test_pool
  test_verify
  test_copy)
 (libraries
  rowtype
  rowtype-postgres
  db_target
  cstruct
  eio
  eio_main
  logs
  mtime
  alcotest
  qcheck-core))

; The SQLite backend: statements, scalars, failures and transactions, on
; databases in memory and in files of their own, which need no server.

(test
 (name test_sqlite)
 (package rowtype-sqlite)
 (modules test_sqlite)
 (libraries
  rowtype
  rowtype-sqlite
  eio
  eio_main
  logs
  mtime
  ptime
  uuidm
  unix
  alcotest
  qcheck-core))

; Migrations against a real Postgres.

(test
 (name test_migrate)
 (package rowtype-migrate)
 (enabled_if %{lib-available:rowtype-migrate.postgres})
 (modules test_migrate)
 (libraries
  rowtype
  rowtype-postgres
  rowtype-migrate
  rowtype-migrate.postgres
  db_target
  eio
  eio_main
  mtime
  unix
  alcotest))

; Migrations on SQLite: the same behaviours as on Postgres, on files of
