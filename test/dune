 (package rowtype-migrate)
 (enabled_if %{lib-available:rowtype-migrate.sqlite})
 (modules test_migrate_sqlite)
 (libraries
  rowtype
  rowtype-sqlite
  rowtype-migrate
  rowtype-migrate.sqlite
  eio
  eio_main
  alcotest))

; The walk of a shape, against a backend that echoes its parameters, which
; needs no database.

(test
 (name test_shape)
 (package rowtype)
 (modules test_shape)
 (libraries rowtype ptime uuidm alcotest qcheck-core qcheck-alcotest))

; The migration files' pieces, which need no database.

(test
 (name test_migrate_files)
 (package rowtype-migrate)
 (enabled_if %{lib-available:rowtype-migrate.postgres})
 (modules test_migrate_files)
 (libraries
  rowtype-migrate
