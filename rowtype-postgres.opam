opam-version: "2.0"
synopsis: "The Postgres backend for rowtype, over postgres-eio"
description:
  "Connections and a pool, notifications, transactions whose own failures are values, a load through one COPY, and a statement checked against the database without running it."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/rowtype"
bug-reports: "https://github.com/hyphatech/rowtype/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.4"}
  "rowtype" {= version}
  "postgres-eio" {>= "0.1.0"}
  "eio" {>= "1.5"}
  "logs" {>= "0.10.0"}
  "mtime" {>= "2.1.0"}
  "eio_main" {with-test & >= "1.5"}
  "alcotest" {with-test & >= "1.9.1"}
  "qcheck-core" {with-test & >= "0.91"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/rowtype.git"
x-maintenance-intent: ["(latest)"]
