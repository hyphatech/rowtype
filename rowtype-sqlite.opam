# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "The SQLite backend for rowtype, over the sqlite3 binding"
description:
  "Connections to a database file or one in memory and a pool of them, each statement run on a system thread so the domain's other fibers go on, transactions whose own failures are values, a load through one prepared insert, and a statement checked against the database without running it."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/rowtype"
bug-reports: "https://github.com/hyphatech/rowtype/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.5"}
  "rowtype" {= version}
  "sqlite3" {>= "5.4.2"}
  "ptime" {>= "1.2.0"}
  "uuidm" {>= "0.9.10"}
  "eio" {>= "1.5"}
  "logs" {>= "0.10.0"}
  "mtime" {>= "2.1.0"}
  "eio_main" {with-test & >= "1.5"}
  "alcotest" {with-test & >= "1.9.1"}
  "qcheck-core" {with-test & >= "0.91"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/rowtype.git"
x-maintenance-intent: ["(latest)"]
