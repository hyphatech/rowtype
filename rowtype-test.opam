# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "A Postgres database a test run owns, in Podman or a server it is handed"
description:
  "A server for a test run -- one it is handed, or one it starts in Podman and removes -- and a database of its own in it for each case, dropped after; a container a killed run left is removed by the next."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/rowtype"
bug-reports: "https://github.com/hyphatech/rowtype/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.5"}
  "rowtype" {= version}
  "rowtype-postgres" {= version}
  "eio" {>= "1.5"}
  "mtime" {>= "2.1.0"}
  "eio_main" {with-test & >= "1.5"}
  "alcotest" {with-test & >= "1.9.1"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/rowtype.git"
x-maintenance-intent: ["(latest)"]
