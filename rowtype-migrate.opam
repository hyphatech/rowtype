# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Migrations for Postgres: plain SQL files, forward only, and the command that applies them"
description:
  "A directory of timestamped SQL files, applied in order under an advisory lock, each in one transaction with the row that records it and a digest of its text, or on its own where Postgres refuses one; a schema dump that changes only when the schema does; and a history squashed into one baseline."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/rowtype"
bug-reports: "https://github.com/hyphatech/rowtype/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.4"}
  "rowtype" {= version}
  "rowtype-postgres" {= version}
  "ptime" {>= "1.2.0"}
  "cmdliner" {>= "2.1.1"}
  "eio" {>= "1.5"}
  "eio_main" {>= "1.5"}
  "alcotest" {with-test & >= "1.9.1"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/rowtype.git"
x-maintenance-intent: ["(latest)"]
